#columns: landcover_type.level1_label, landcover_type.level2_label, landcover_type.level3_label
#values: 'Thessaly Region' refer to landcover_upscaled.latitude BETWEEN 39.0 AND 40.0 AND landcover_upscaled.longitude BETWEEN 21.2 AND 24.4
#SELECT: landcover_type.level1_label, landcover_type.level2_label, landcover_type.level3_label
#SQL: SELECT DISTINCT lt.level1_label, lt.level2_label, lt.level3_label
FROM landcover_upscaled lu
JOIN landcover_type lt ON lu.level3_code = lt.level3_label
WHERE lu.latitude BETWEEN 39.0 AND 40.0
  AND lu.longitude BETWEEN 21.2 AND 24.4;
```

