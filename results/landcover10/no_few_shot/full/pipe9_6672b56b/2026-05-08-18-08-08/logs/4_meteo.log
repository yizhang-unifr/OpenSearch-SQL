FROM meteo_tmean m
JOIN (
    SELECT latitude, longitude, UNNEST(ranks) AS rank_entry
    FROM landcover_upscaled
    WHERE latitude BETWEEN 47.2 AND 47.6 AND longitude BETWEEN 8.4 AND 8.8
) lu ON m.latitude = lu.latitude AND m.longitude = lu.longitude
JOIN landcover_type lt ON lt.level3_code = (lu.rank_entry)[1][1]  -- assuming first element of first array is the dominant landcover code
WHERE EXTRACT(YEAR FROM m.time) = 2021
  AND (lt.level1_label = 'Forest and semi-natural areas' OR lt.level2_label ILIKE '%Urban%')
GROUP BY lt.level1_label;
