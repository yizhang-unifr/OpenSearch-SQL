#SQL: SELECT mt.tmean
FROM meteo_tmean mt
JOIN landcover_upscaled lc ON mt.latitude = lc.latitude AND mt.longitude = lc.longitude
JOIN landcover_type lt ON lc.level1_label = lt.level1_label
WHERE lt.level1_label = 'Forest and semi-natural areas'
  AND EXTRACT(YEAR FROM mt.time) = 2020;
```

